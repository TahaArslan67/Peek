# Peek signaling sunucusu - ortam değişkenleri
#
# Render.com deploy sırasında bu değerleri Environment sekmesinden girin.
# Lokalde çalışırken bu dosyayı .env olarak kopyalayıp düzenleyebilirsiniz
# (server .env'i otomatik yüklemek için dotenv kullanmaz; Render env'leri
# doğrudan process.env'e enjekte eder. Lokalde `PORT=8080 node index.js`
# şeklinde geçebilirsiniz).

# Sunucunun dinleyeceği port (Render otomatik sağlar)
PORT=8080

# Not: Signaling sunucusu TURN gerektirmez. TURN ayarı Android uygulamasında
# (Ayarlar ekranı) yapılır. Sunucu sadece mesaj relay yapar.
